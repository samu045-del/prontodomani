{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prontodomani",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/demo/*"]
  },
  "vars": {
    "MAIL_TO": "samuele@prontodomani.it",
    "MAIL_FROM": "ProntoDomani <modulo@send.prontodomani.it>"
  },
  "observability": { "enabled": true }
}
