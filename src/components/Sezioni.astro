---
// Offerta in breve, Settori, Come funziona, Incluso/escluso, Prezzi, Esempi, FAQ
import Spunta from './Spunta.astro';
import { prezzi, settori, progetti, incluso, escluso, faq } from '../data/site';

const esempi = progetti.filter((p) => p.consenso);
const icone = {
  sport: '<circle cx="22" cy="22" r="10" fill="none" stroke="#0F3A34" stroke-width="2"/><path d="M22 12l4 7-4 4-4-4z" fill="none" stroke="#0F3A34" stroke-width="1.8" stroke-linejoin="round"/>',
  documento: '<rect x="13" y="11" width="18" height="22" rx="2.5" fill="none" stroke="#0F3A34" stroke-width="2"/><path d="M17 17h10M17 22h10M17 27h6" stroke="#0F3A34" stroke-width="2" stroke-linecap="round"/>',
  medico: '<circle cx="22" cy="22" r="12" fill="none" stroke="#0F3A34" stroke-width="2"/><path d="M22 15v14M15 22h14" stroke="#0F3A34" stroke-width="2.4" stroke-linecap="round"/>',
};
---
<!-- Offerta in breve -->
<section class="striscia" aria-label="L'offerta in breve">
  <ul class="contenitore striscia__lista">
    <li><strong>{prezzi.sito} €</strong> una tantum</li>
    <li>Fino a 4 pagine</li>
    <li>Dominio e hosting del primo anno inclusi</li>
    <li>Pensato prima per lo smartphone</li>
    <li>2 giri di revisione</li>
  </ul>
</section>

<!-- Settori -->
<section id="settori" class="contenitore sezione" aria-labelledby="settori-titolo">
  <div class="intestazione">
    <p class="occhiello">Settori</p>
    <h2 id="settori-titolo" class="titolo-sezione">Partiamo da strutture già pensate per il tuo lavoro</h2>
    <p>Per questo siamo veloci: non ripartiamo da zero, adattiamo una base collaudata ai tuoi contenuti e alla tua immagine.</p>
  </div>
  <div class="griglia">
    {settori.map((s) => (
      <article class="card">
        <svg width="44" height="44" viewBox="0 0 44 44" aria-hidden="true">
          <rect width="44" height="44" rx="12" fill="#E8F2EE"></rect>
          <g set:html={icone[s.icona]} />
        </svg>
        <h3>{s.titolo}</h3>
        <p>{s.testo}</p>
        <a href="#richiesta" class="card__link">Chiedi una demo per il tuo settore →</a>
      </article>
    ))}
  </div>
  <p class="nota" style="margin-top: 24px;">Il tuo settore non è qui? <a href="#richiesta">Scrivici lo stesso</a>: valutiamo ogni richiesta.</p>
</section>

<!-- Come funziona -->
<section id="come-funziona" class="contenitore sezione" aria-labelledby="come-titolo">
  <div class="intestazione">
    <p class="occhiello">Come funziona</p>
    <h2 id="come-titolo" class="titolo-sezione">Tre passaggi, nessuna sorpresa</h2>
  </div>
  <ol class="griglia passi">
    <li class="passo">
      <span class="passo__tempo">01 · Oggi</span>
      <h3>Ci racconti la tua attività</h3>
      <p>Una breve chiamata o il modulo guidato. Ci invii testi, logo e immagini; se mancano, ti diciamo esattamente cosa serve.</p>
    </li>
    <li class="passo passo--scuro">
      <span class="passo__tempo">02 · Entro 24 ore</span>
      <h3>Ricevi la demo</h3>
      <p>Una versione navigabile del sito, da aprire su telefono e computer. Le 24 ore partono da quando il materiale è completo.</p>
    </li>
    <li class="passo">
      <span class="passo__tempo">03 · Quando approvi</span>
      <h3>Vai online</h3>
      <p>Due giri di revisione inclusi. Pubblichiamo solo dopo il tuo ok, sul dominio intestato a te.</p>
    </li>
  </ol>
  <p class="nota" style="margin-top: 24px;">Ritardi nel materiale, richieste fuori pacchetto o revisioni aggiuntive possono spostare i tempi. Te lo diciamo sempre prima.</p>
</section>

<!-- Incluso / escluso -->
<section class="fascia-bianca" aria-label="Cosa è incluso">
  <div class="contenitore sezione griglia" style="--min: 420px; gap: 48px;">
    <div class="colonna">
      <h2 class="titolo-medio">Cosa è incluso</h2>
      <ul class="lista-spunte">{incluso.map((v) => <li><Spunta />{v}</li>)}</ul>
    </div>
    <div class="colonna">
      <h2 class="titolo-medio">Cosa non è incluso</h2>
      <ul class="lista-spunte">{escluso.map((v) => <li><Spunta tipo="no" />{v}</li>)}</ul>
      <p class="riquadro">Ti serve qualcosa in più? Te lo preventiviamo a parte, prima di iniziare.</p>
    </div>
  </div>
</section>

<!-- Prezzi -->
<section id="prezzi" class="contenitore sezione" aria-labelledby="prezzi-titolo">
  <div class="intestazione">
    <p class="occhiello">Prezzi</p>
    <h2 id="prezzi-titolo" class="titolo-sezione">Un prezzo, scritto qui</h2>
  </div>
  <div class="griglia" style="--min: 380px;">
    <div class="prezzo prezzo--scuro">
      <p class="prezzo__nome">Il tuo sito</p>
      <p class="prezzo__cifra"><span>{prezzi.sito} €</span> una tantum</p>
      <p>Realizzazione, dominio .it e hosting per i primi 12 mesi. Paghi una volta, il resto del primo anno è a carico nostro.</p>
      <a href="#richiesta" class="btn btn--lime" style="align-self: flex-start;">Richiedi una proposta</a>
    </div>
    <div class="prezzo">
      <p class="prezzo__nome">Dal secondo anno</p>
      <p class="prezzo__cifra"><span>{prezzi.manutenzione} €</span> all'anno</p>
      <ul>
        <li>Hosting e certificato SSL{prezzi.rinnovoDominioIncluso && ', rinnovo del dominio'}</li>
        <li>Backup periodici e monitoraggio</li>
        <li>Aggiornamenti tecnici e assistenza</li>
        <li>30 minuti di piccole modifiche ogni trimestre</li>
      </ul>
    </div>
  </div>
  <p class="nota" style="margin-top: 24px;">{prezzi.notaIva} Il dominio è sempre intestato a te. Se non rinnovi la manutenzione, ti aiutiamo a trasferire sito e dominio dove preferisci.</p>
</section>

<!-- Esempi: compare solo con progetti autorizzati -->
{esempi.length > 0 && (
  <section id="esempi" class="fascia-menta" aria-labelledby="esempi-titolo">
    <div class="contenitore sezione">
      <div class="intestazione">
        <p class="occhiello">Esempi</p>
        <h2 id="esempi-titolo" class="titolo-sezione">Lavori già online</h2>
      </div>
      <div class="griglia" style="--min: 420px;">
        {esempi.map((p) => (
          <article class="esempio">
            {p.immagine
              ? <img src={p.immagine} alt={`Homepage di ${p.nome}`} loading="lazy" width="1200" height="750" />
              : <div class="esempio__vuoto" aria-hidden="true"></div>}
            <div class="esempio__testo">
              <h3><a href={p.url} target="_blank" rel="noopener">{p.nome}<span class="sr-only"> (si apre in una nuova scheda)</span></a></h3>
              <p>{p.settore} · {p.funzioni}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<!-- FAQ -->
<section id="faq" class="contenitore sezione sezione--stretta" aria-labelledby="faq-titolo">
  <h2 id="faq-titolo" class="titolo-sezione" style="margin-bottom: 28px;">Domande frequenti</h2>
  <div class="faq">
    {faq.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.d}</summary>
        <p>{f.r}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .striscia { background: var(--petrolio); color: var(--bianco); }
  .striscia__lista { list-style: none; margin: 0 auto; padding-block: 26px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; font-weight: 500; }
  .striscia strong { font-family: var(--font-titoli); font-size: 22px; color: var(--lime); }

  .card__link { margin-top: auto; font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }

  .passi { list-style: none; margin: 0; padding: 0; }
  .passo { background: var(--menta); border-radius: var(--raggio); padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .passo h3 { font-size: 22px; }
  .passo__tempo { align-self: flex-start; font-size: 13px; font-weight: 700; color: var(--petrolio); background: var(--bianco); padding: 5px 12px; border-radius: 999px; }
  .passo--scuro { background: var(--petrolio); color: #E3EEEA; }
  .passo--scuro h3 { color: var(--bianco); }
  .passo--scuro .passo__tempo { background: var(--lime); }

  .fascia-bianca { background: var(--bianco); border-block: 1px solid var(--bordo); }
  .fascia-menta { background: var(--menta); }
  .colonna { display: flex; flex-direction: column; gap: 20px; }
  .titolo-medio { font-weight: 800; font-size: 34px; letter-spacing: -0.03em; }
  .riquadro { font-size: 15px; background: var(--avorio); border-radius: 14px; padding: 16px 18px; }

  .prezzo { background: var(--bianco); border: 1px solid var(--bordo); border-radius: 24px; padding: 36px; display: flex; flex-direction: column; gap: 16px; }
  .prezzo--scuro { background: var(--petrolio); border-color: var(--petrolio); color: #E3EEEA; }
  .prezzo__nome { font-weight: 600; color: var(--verde); }
  .prezzo--scuro .prezzo__nome { color: var(--lime); }
  .prezzo__cifra { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; }
  .prezzo__cifra span { font-family: var(--font-titoli); font-weight: 800; font-size: 64px; line-height: 1; color: var(--petrolio); }
  .prezzo--scuro .prezzo__cifra span { color: var(--bianco); }
  .prezzo ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; font-size: 16px; }

  .esempio { background: var(--bianco); border-radius: var(--raggio); overflow: hidden; }
  .esempio img, .esempio__vuoto { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: #D6E3DE; }
  .esempio__testo { padding: 24px; display: flex; flex-direction: column; gap: 6px; }
  .esempio__testo h3 { font-size: 20px; }

  .faq { border-top: 1px solid #DAD7CD; }
  .faq details { border-bottom: 1px solid #DAD7CD; padding: 10px 0; }
  .faq summary {
    font-family: var(--font-titoli); font-weight: 700; font-size: 19px; color: var(--petrolio);
    min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    cursor: pointer; list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-size: 26px; font-weight: 500; color: var(--verde); flex: none; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { padding: 4px 0 12px; }
</style>
