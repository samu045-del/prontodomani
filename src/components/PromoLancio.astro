---
import { promo, euro } from '../data/site';
---
{promo.attiva && (
  <section id="promozione" class="promo" aria-labelledby="promo-titolo">
    <div class="contenitore promo__griglia">
      <div class="promo__testo">
        <p class="occhiello">Promozione di lancio</p>
        <h2 id="promo-titolo" class="titolo-sezione promo__titolo">ProntoDomani parte oggi.<br />Il sito della tua società da {euro(promo.prezzo)}.</h2>
        <p class="lead">Per il lancio abbiamo riservato una condizione dedicata ai primi {promo.limite} club che scelgono il pacchetto START.</p>
        <a href="/contatti/?pacchetto=start" class="btn btn--lime">Approfitta della promozione</a>
      </div>
      <dl class="promo__dati">
        <div><dt>Pacchetto START</dt><dd>{euro(promo.prezzo)}</dd></div>
        <div><dt>Prezzo dopo la promozione</dt><dd>{euro(promo.prezzoListino)}</dd></div>
        <div><dt>Valida per</dt><dd>i primi {promo.limite} club</dd></div>
        <div><dt>Gestione tecnica</dt><dd>primo anno incluso</dd></div>
      </dl>
    </div>
  </section>
)}

<style>
  .promo { background: var(--petrolio); color: #DCE9E4; position: relative; overflow: hidden; }
  .promo::after {
    content: ''; position: absolute; right: -120px; top: -120px; width: 420px; height: 420px; border-radius: 50%;
    border: 70px solid rgba(198, 243, 107, 0.08); pointer-events: none;
  }
  .promo__griglia { position: relative; z-index: 1; display: grid; gap: 48px; align-items: center; padding-block: clamp(64px, 8vw, 96px); grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .promo__testo { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .promo h2 { color: var(--bianco); }
  .promo__titolo { font-size: clamp(30px, 3.6vw, 44px); }
  .promo .occhiello { color: var(--lime); }
  .promo__dati { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(255,255,255,.14); border-radius: 22px; overflow: hidden; }
  .promo__dati div { background: #134640; padding: 22px; display: flex; flex-direction: column; gap: 4px; }
  .promo__dati dt { font-size: 13px; color: #B9D3CB; }
  .promo__dati dd { margin: 0; font-family: var(--font-titoli); font-weight: 800; font-size: clamp(20px, 2.4vw, 28px); color: var(--bianco); line-height: 1.15; }
  .promo__dati div:first-child dd { color: var(--lime); }
</style>
