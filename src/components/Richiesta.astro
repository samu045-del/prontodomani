---
// Modulo di richiesta. Invia a /api/richiesta (Cloudflare Worker).
import { opzioniSettore, turnstileSiteKey, azienda, pacchetti, promo, euro, prezzoMostrato } from '../data/site';
const mappaSettori: Record<string, string> = {};
---
<form id="modulo" class="modulo" method="post" action="/api/richiesta" data-settori={JSON.stringify(mappaSettori)}>
  <p id="esito-errore" class="modulo__errore" role="alert" hidden>
    Non sono riuscito a ricevere la richiesta. Riprova tra qualche minuto o scrivimi a <a href={`mailto:${azienda.email}`}>{azienda.email}</a>.
  </p>

  <label class="campo">Nome e cognome
    <input type="text" name="nome" autocomplete="name" required maxlength="120" />
  </label>
  <label class="campo">Nome della società
    <input type="text" name="azienda" autocomplete="organization" required maxlength="160" />
  </label>
  <label class="campo">Email
    <input type="email" name="email" autocomplete="email" required maxlength="200" />
  </label>
  <label class="campo"><span>Telefono <span class="aiuto">(facoltativo)</span></span>
    <input type="tel" name="telefono" autocomplete="tel" maxlength="40" />
  </label>
  <label class="campo">Sport
    <select name="settore" required>
      <option value="" selected disabled>Scegli…</option>
      {opzioniSettore.map((o) => <option>{o}</option>)}
    </select>
  </label>
  <label class="campo">Pacchetto
    <select name="pacchetto">
      <option value="Non so ancora" selected>Non so ancora</option>
      {pacchetti.map((p) => (
        <option value={p.nome}>{p.nome} · {euro(prezzoMostrato(p))}{promo.attiva && p.id === promo.pacchetto ? ' (promozione di lancio)' : ''}</option>
      ))}
    </select>
  </label>
  <label class="campo"><span>Sito o pagina social attuale <span class="aiuto">(facoltativo)</span></span>
    <input type="text" name="sito" inputmode="url" placeholder="www.… oppure facebook.com/…" maxlength="200" />
  </label>
  <label class="campo">Quando vorresti essere online?
    <select name="tempistiche" required>
      <option value="" selected disabled>Scegli…</option>
      <option>Il prima possibile</option>
      <option>Entro un mese</option>
      <option>Entro tre mesi</option>
      <option>Sto solo valutando</option>
    </select>
  </label>
  <label class="campo campo--intero">Raccontami la tua società
    <textarea name="messaggio" rows="4" required maxlength="2000"></textarea>
    <span class="aiuto">Bastano poche righe: quante squadre avete, cosa vi manca oggi. Non inserire dati personali di atleti o tesserati.</span>
  </label>

  <div class="trappola" aria-hidden="true">
    <label>Non compilare questo campo <input type="text" name="sito_web_2" tabindex="-1" autocomplete="off" /></label>
  </div>

  <label class="consenso campo--intero">
    <input type="checkbox" name="privacy" value="si" required />
    <span>Ho letto l’<a href="/privacy/" target="_blank" rel="noopener">informativa privacy</a> e acconsento a essere ricontattato per questa richiesta.</span>
  </label>

  <div class="campo--intero">
    <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-language="it" data-theme="light"></div>
    <noscript><p class="aiuto">Per inviare il modulo serve JavaScript attivo (protezione antispam). In alternativa scrivimi a {azienda.email}.</p></noscript>
  </div>

  <button type="submit" class="btn btn--primario campo--intero">Invia la richiesta</button>
</form>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
<script>
  const modulo = document.getElementById('modulo') as HTMLFormElement | null;
  const parametri = new URLSearchParams(window.location.search);
  if (parametri.get('esito') === 'errore') document.getElementById('esito-errore')?.removeAttribute('hidden');
  if (modulo) {
    const mappa = JSON.parse(modulo.dataset.settori || '{}') as Record<string, string>;
    const settore = parametri.get('settore');
    const pacchetto = parametri.get('pacchetto');
    if (settore && mappa[settore]) (modulo.elements.namedItem('settore') as HTMLSelectElement).value = mappa[settore];
    if (pacchetto) (modulo.elements.namedItem('pacchetto') as HTMLSelectElement).value = pacchetto.toUpperCase();
  }
</script>

<style>
  .modulo {
    background: var(--bianco); color: var(--ardesia); border-radius: var(--raggio-grande); padding: clamp(24px, 4vw, 40px);
    display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    border: 1px solid var(--bordo); box-shadow: 0 30px 60px -40px rgba(15, 58, 52, .4);
  }
  .modulo .btn { width: 100%; }
  .modulo__errore { grid-column: 1 / -1; background: #FDECEA; color: #8A1C12; border-radius: 10px; padding: 12px 14px; font-size: 15px; }
  .modulo__errore a { color: #8A1C12; }
  .consenso { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; }
  .consenso input { width: 20px; height: 20px; margin-top: 2px; flex: none; accent-color: var(--petrolio); }
</style>
