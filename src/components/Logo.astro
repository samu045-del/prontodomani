---
interface Props { size?: number }
const { size = 34 } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 34 34" aria-hidden="true">
    <rect x="1" y="1" width="32" height="32" rx="9" fill="#0F3A34"></rect>
    <path d="M11 25V9h7.5a5 5 0 0 1 0 10H11" fill="none" stroke="#F7F5EF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle cx="24.5" cy="24.5" r="3.2" fill="#C6F36B"></circle>
  </svg>
  <span class="logo__testo">Pronto<span>Domani</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo__testo { font-family: var(--font-titoli); font-weight: 800; font-size: 21px; letter-spacing: -0.02em; color: var(--petrolio); }
  .logo__testo span { color: var(--verde); }
</style>
