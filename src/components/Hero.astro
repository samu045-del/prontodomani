---
import Spunta from './Spunta.astro';
import Contatore from './Contatore.astro';
import { prezzi } from '../data/site';
---
<section class="hero contenitore" aria-labelledby="hero-titolo">
  <div class="hero__testo">
    <p class="occhiello">Siti web per studi, professionisti e società sportive</p>
    <h1 id="hero-titolo">Oggi ci conosci.<br /><mark>Domani</mark> sei online.</h1>
    <p class="hero__sotto">Ci racconti la tua attività, noi la trasformiamo in un sito curato e veloce. La prima demo arriva entro 24 ore e va online solo quando ti convince.</p>
    <ul class="lista-spunte hero__punti">
      <li><Spunta />Prima demo navigabile entro 24 ore*</li>
      <li><Spunta />Online solo dopo il tuo ok</li>
      <li><Spunta />{prezzi.sito} € con dominio e hosting del primo anno inclusi</li>
    </ul>
    <div class="hero__cta">
      <a href="#richiesta" class="btn btn--primario">Richiedi una proposta gratuita</a>
      <a href="#come-funziona" class="btn btn--secondario">Come funziona</a>
    </div>
    <p class="piccolo">*Le 24 ore partono quando abbiamo brief completo, testi, logo e immagini. <a href="#come-funziona">Vedi i dettagli</a>.</p>
  </div>

  <div class="hero__visual">
    <figure class="browser">
      <div class="browser__barra" aria-hidden="true">
        <span></span><span></span><span></span>
        <span class="browser__url">studioaurora-demo.prontodomani.it</span>
      </div>
      <div class="browser__pagina" aria-hidden="true">
        <div class="demo__nav"><strong>Studio Aurora</strong><span>Servizi · Équipe · Orari · Contatti</span></div>
        <div class="demo__hero">
          <div>
            <p class="demo__titolo">Odontoiatria per tutta la famiglia</p>
            <p class="demo__testo">Visite, igiene e ortodonzia. Orari estesi il martedì e il giovedì.</p>
            <span class="demo__btn">Prenota una visita</span>
          </div>
          <div class="demo__foto"></div>
        </div>
        <div class="demo__card"><span></span><span></span><span></span></div>
      </div>
      <figcaption class="piccolo">Concept dimostrativo: Studio Aurora è un nome inventato.</figcaption>
    </figure>
    <div class="hero__contatore"><Contatore /></div>
  </div>
</section>

<style>
  .hero {
    padding-block: 72px 64px;
    display: grid; gap: 56px; align-items: center;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
  }
  .hero__testo { display: flex; flex-direction: column; gap: 24px; }
  h1 { font-weight: 800; font-size: clamp(42px, 5.4vw, 68px); line-height: 1.1; letter-spacing: -0.035em; }
  mark {
    background: linear-gradient(transparent 14%, var(--lime) 14%, var(--lime) 94%, transparent 94%);
    color: inherit; padding: 0 0.18em; border-radius: 0.18em;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  .hero__sotto { font-size: 19px; max-width: 34em; }
  .hero__punti { font-weight: 500; color: var(--petrolio); gap: 10px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero__visual { position: relative; padding-bottom: 32px; }
  .browser { margin: 0; }
  .browser__barra { display: flex; align-items: center; gap: 6px; padding: 12px 14px; background: #F1EFE8; border: 1px solid var(--bordo); border-bottom: 0; border-radius: 18px 18px 0 0; }
  .browser__barra > span:not(.browser__url) { width: 10px; height: 10px; border-radius: 50%; background: #D5D2C8; }
  .browser__url { margin-left: 12px; flex: 1; font-size: 12px; color: var(--grigio-testo); background: var(--bianco); border-radius: 6px; padding: 3px 10px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .browser__pagina {
    padding: 22px 26px 30px; display: flex; flex-direction: column; gap: 16px;
    background: linear-gradient(180deg, #FFFFFF 0%, #F4F8F6 100%);
    border: 1px solid var(--bordo); border-radius: 0 0 18px 18px;
    box-shadow: 0 30px 60px -30px rgba(15, 58, 52, 0.35);
  }
  .browser figcaption { margin-top: 10px; max-width: 42%; }
  .demo__nav { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; }
  .demo__nav strong { font-family: var(--font-titoli); font-size: 15px; color: #1B4F72; }
  .demo__hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: 18px; align-items: center; }
  .demo__hero > div:first-child { display: flex; flex-direction: column; gap: 10px; }
  .demo__titolo { font-family: var(--font-titoli); font-weight: 700; font-size: 22px; line-height: 1.15; color: #12324A; }
  .demo__testo { font-size: 12px; line-height: 1.5; }
  .demo__btn { align-self: flex-start; font-size: 12px; font-weight: 600; color: #fff; background: #1B4F72; padding: 7px 14px; border-radius: 999px; }
  .demo__foto { height: 130px; border-radius: 12px; background: linear-gradient(135deg, #DCE8EF, #C4D7E2); }
  .demo__card { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .demo__card span { height: 54px; border-radius: 10px; background: #fff; border: 1px solid #E1E8EC; }

  .hero__contatore { position: absolute; right: -18px; bottom: -24px; width: min(320px, 88%); }
  @media (max-width: 720px) {
    .hero { padding-block: 40px; gap: 40px; }
    .hero__visual { padding-bottom: 0; }
    .hero__contatore { position: static; width: 100%; margin-top: 20px; }
    .browser figcaption { max-width: none; }
  }
</style>
