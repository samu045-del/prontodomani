---
import Base from '../layouts/Base.astro';
import Spunta from '../components/Spunta.astro';
import Pacchetti from '../components/Pacchetti.astro';
import Care from '../components/Care.astro';
import Promessa24 from '../components/Promessa24.astro';
import CtaFinale from '../components/CtaFinale.astro';
import { promo, euro } from '../data/site';
import { settori } from '../data/settori';

const lavori = [
  { img: '/lavori/fccds.webp', url: 'https://fccds.it', nome: 'fccds.it', cosa: 'Società di calcio' },
  { img: '/lavori/emada.webp', url: 'https://emada.it', nome: 'emada.it', cosa: 'Consulenza fiscale, Torino e Milano' },
];
---
<Base
  title="ProntoDomani · Siti web professionali per società sportive, psicologi e dentisti"
  description={`Siti web professionali su misura per società sportive, psicologi e dentisti. Prima bozza in 24 ore, prezzi chiari da ${euro(promo.prezzo)}, gestione tecnica del primo anno inclusa.`}
>
  <!-- HERO -->
  <section class="hero contenitore" aria-labelledby="hero-titolo">
    <div class="hero__testo">
      <h1 id="hero-titolo">Un sito fatto<br />come si deve.<br /><mark>Pronto domani.</mark></h1>
      <p class="lead">Mi mandi testi, logo e foto. Il giorno dopo apri sul telefono la bozza del tuo sito. La sistemiamo insieme e va online quando ti convince.</p>
      <div class="hero__cta">
        <a href="/contatti/" class="btn btn--primario">Richiedi il tuo sito</a>
        <a href="#prezzi" class="btn btn--secondario">Vedi i prezzi</a>
      </div>
      <ul class="hero__prove">
        <li><Spunta />Bozza in 24 ore, a materiale completo</li>
        <li><Spunta />Prezzi fissi, da {euro(promo.prezzo)}</li>
        <li><Spunta />Dominio sempre a tuo nome</li>
      </ul>
    </div>

    <div class="hero__visual">
      {lavori.map((l, i) => (
        <a href={l.url} target="_blank" rel="noopener" class:list={['telefono', `telefono--${i + 1}`]}>
          <span class="telefono__schermo"><img src={l.img} alt={`Il sito ${l.nome} visto da smartphone`} width="600" height="917" loading="eager" /></span>
          <span class="telefono__etichetta"><strong>{l.nome}</strong> {l.cosa}</span>
        </a>
      ))}
      {promo.attiva && (
        <a href="/prezzi/#promozione" class="hero__bollino">
          <span>Promozione di lancio</span>
          <strong>START {euro(promo.prezzo)}</strong>
          <span>primi {promo.limite} clienti</span>
        </a>
      )}
    </div>
  </section>

  <Promessa24 />

  <!-- NOTA -->
  <section class="contenitore sezione nota-s" aria-labelledby="nota-titolo">
    <h2 id="nota-titolo" class="nota-s__titolo">Perché esiste ProntoDomani</h2>
    <div class="nota-s__testo">
      <p>Ciao, sono Samuele.</p>
      <p>Chi allena una squadra, segue dei pazienti o manda avanti uno studio non ha tempo di stare dietro a un’agenzia per tre mesi. Però ha bisogno di un sito che non faccia brutta figura, che si legga bene dal telefono e che dica le cose giuste.</p>
      <p>Io lavoro così: mi mandi il materiale e il giorno dopo hai una bozza vera, non un preventivo. Da lì la sistemiamo insieme, con al massimo due giri di modifiche, e il prezzo è quello scritto qui sotto.</p>
      <p>Gli ultimi due che ho fatto sono <a href="https://fccds.it" target="_blank" rel="noopener">fccds.it</a>, per una società di calcio, e <a href="https://emada.it" target="_blank" rel="noopener">emada.it</a>, per uno studio di consulenza fiscale. Aprili dal telefono: è lì che li guarda la maggior parte delle persone.</p>
      <p>Ogni richiesta la leggo io. Ti rispondo entro un giorno lavorativo.</p>
      <p class="nota-s__firma">Samuele</p>
    </div>
  </section>

  <!-- SETTORI -->
  <section class="fascia-bianca" aria-labelledby="settori-titolo">
    <div class="contenitore sezione">
      <h2 id="settori-titolo" class="titolo-sezione settori__titolo">Per chi lavoro</h2>
      <ul class="settori">
        {settori.map((s) => (
          <li style={`--acc:${s.tema.accento}`}>
            <a href={`/${s.slug}/`}>
              <strong>{s.etichetta}</strong>
              <span>{s.card.testo}</span>
              <em>Com’è fatto il sito →</em>
            </a>
          </li>
        ))}
      </ul>
      <p class="nota settori__nota">Fai altro? Scrivimi lo stesso: emada.it, per dire, è uno studio di commercialisti.</p>
    </div>
  </section>

  <!-- PREZZI -->
  <section id="prezzi" class="fascia-menta" aria-labelledby="prezzi-titolo">
    <div class="contenitore sezione">
      <div class="intestazione">
        <h2 id="prezzi-titolo" class="titolo-sezione">Quanto costa</h2>
        <p class="lead">Tre pacchetti a prezzo fisso. Design, versione per smartphone, SEO tecnica, pubblicazione e il primo anno di gestione sono sempre compresi.</p>
      </div>
      <Pacchetti idTitolo="home" />
      <div class="prezzi__care"><Care compatto /></div>
      <p class="nota prezzi__nota"><a href="/prezzi/" class="link-freccia">Confronto completo e domande sui prezzi</a></p>
    </div>
  </section>

  <CtaFinale
    titolo="Raccontami cosa fai."
    testo="Bastano due righe. Ti rispondo entro un giorno lavorativo con cosa serve per partire e quale pacchetto ha senso per te."
  />
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(48px, 7vw, 88px) clamp(56px, 8vw, 96px); display: grid; gap: 56px; align-items: center; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
  .hero__testo { display: flex; flex-direction: column; gap: 22px; }
  h1 { font-weight: 800; font-size: clamp(40px, 4.6vw, 62px); line-height: 1.04; letter-spacing: -0.045em; }
  h1 mark {
    color: inherit; padding: 0 .06em; white-space: nowrap;
    background: linear-gradient(transparent 58%, var(--lime) 58%, var(--lime) 92%, transparent 92%);
  }
  .hero .lead { max-width: 34em; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__prove { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 22px; font-weight: 500; font-size: 15px; color: var(--petrolio); }
  .hero__prove li { display: flex; gap: 8px; align-items: center; }

  .hero__visual { position: relative; display: flex; justify-content: center; gap: 0; padding-top: 24px; }
  .telefono { display: flex; flex-direction: column; gap: 12px; width: min(46%, 240px); text-decoration: none; color: var(--grigio-testo); }
  .telefono--1 { transform: rotate(-3deg) translateY(10px); z-index: 1; }
  .telefono--2 { transform: rotate(2.5deg) translateY(56px); margin-left: -18px; }
  .telefono__schermo {
    display: block; border-radius: 30px; padding: 7px; background: #11201d;
    box-shadow: 0 30px 50px -28px rgba(15, 58, 52, .55);
  }
  .telefono__schermo img { border-radius: 24px; width: 100%; }
  .telefono__etichetta { font-size: 13px; line-height: 1.35; padding-left: 6px; }
  .telefono__etichetta strong { display: block; color: var(--petrolio); font-size: 14px; }
  .telefono:hover .telefono__etichetta strong { text-decoration: underline; }
  .hero__bollino {
    position: absolute; z-index: 3; right: 0; top: 0; width: 120px; height: 120px; border-radius: 50%;
    background: var(--lime); color: var(--petrolio); text-decoration: none;
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
    font-size: 10.5px; font-weight: 600; line-height: 1.25; transform: rotate(8deg);
    box-shadow: 0 16px 30px -14px rgba(15, 58, 52, .5);
  }
  .hero__bollino strong { font-family: var(--font-titoli); font-size: 18px; font-weight: 800; letter-spacing: -.02em; margin: 2px 0; }
  .hero__bollino:hover { color: var(--petrolio); transform: rotate(4deg) scale(1.03); }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; gap: 32px; }
    .hero__visual { padding-bottom: 48px; }
    .hero__bollino { display: none; } /* su smartphone c'è già il pulsante fisso START */
  }

  /* Nota di Samuele */
  .nota-s { display: grid; gap: 32px 64px; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); }
  .nota-s__titolo { font-size: clamp(24px, 2.4vw, 30px); line-height: 1.15; letter-spacing: -.03em; }
  .nota-s__testo { display: flex; flex-direction: column; gap: 16px; max-width: 620px; font-size: 18px; line-height: 1.65; }
  .nota-s__testo p:first-child { font-family: var(--font-titoli); font-weight: 700; color: var(--petrolio); font-size: 21px; }
  .nota-s__firma { font-family: var(--font-titoli); font-weight: 800; color: var(--petrolio); font-size: 22px; letter-spacing: -.02em; margin-top: 4px; }
  @media (max-width: 860px) { .nota-s { grid-template-columns: 1fr; } }

  /* Settori */
  .settori__titolo { margin-bottom: 28px; }
  .settori { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .settori a {
    height: 100%; display: flex; flex-direction: column; gap: 10px; padding: 26px 26px 22px;
    border: 1px solid var(--bordo); border-top: 4px solid var(--acc); border-radius: var(--raggio);
    text-decoration: none; color: var(--ardesia); background: var(--carta);
  }
  .settori a:hover { border-color: var(--acc); }
  .settori strong { font-family: var(--font-titoli); color: var(--petrolio); font-size: 20px; line-height: 1.2; }
  .settori span { font-size: 15.5px; flex: 1; }
  .settori em { font-style: normal; font-weight: 600; color: var(--acc); font-size: 15px; }
  .settori__nota { margin-top: 20px; }

  .prezzi__care { margin-top: 24px; }
  .prezzi__nota { margin-top: 16px; }
</style>
