---
import Base from '../layouts/Base.astro';
import Spunta from '../components/Spunta.astro';
import Pacchetti from '../components/Pacchetti.astro';
import Care from '../components/Care.astro';
import Promessa24 from '../components/Promessa24.astro';
import Formazione from '../components/Formazione.astro';
import CtaFinale from '../components/CtaFinale.astro';
import { promo, euro } from '../data/site';

const schermate = [
  { img: '/lavori/fccds-home.webp', cosa: 'Prossima partita con il conto alla rovescia' },
  { img: '/lavori/fccds-rosa.webp', cosa: 'La rosa, con le figurine da girare' },
  { img: '/lavori/fccds-calendario.webp', cosa: 'Calendario, risultati e classifica' },
  { img: '/lavori/fccds-partner.webp', cosa: 'Gli sponsor, in vetrina' },
];
---
<Base
  title="ProntoDomani · Siti web per società sportive, ASD e SSD"
  description={`Il sito della tua società sportiva, con calendario, rosa, sponsor e iscrizioni. Prima bozza in 24 ore, prezzi fissi da ${euro(promo.prezzo)}, dominio intestato alla società.`}
>
  <!-- HERO -->
  <section class="hero contenitore" aria-labelledby="hero-titolo">
    <div class="hero__testo">
      <p class="hero__etichetta">Per società sportive · ASD e SSD</p>
      <h1 id="hero-titolo">Un sito fatto come si deve. <mark>Pronto domani.</mark></h1>
      <p class="lead">Calendario, rosa, sponsor e iscrizioni: tutto quello che oggi sta sparso tra Facebook e i gruppi WhatsApp, finalmente in un sito vero. Mi mandi stemma e foto, il giorno dopo hai la bozza sul telefono.</p>
      <div class="hero__cta">
        <a href="/contatti/" class="btn btn--primario">Richiedi il sito della tua società</a>
        <a href="#prezzi" class="btn btn--secondario">Vedi i prezzi</a>
      </div>
      <ul class="hero__prove">
        <li><Spunta />Bozza in 24 ore, a materiale completo</li>
        <li><Spunta />Prezzi fissi, da {euro(promo.prezzo)}</li>
        <li><Spunta />Dominio intestato alla società</li>
      </ul>
    </div>

    <a href="https://fccds.it" target="_blank" rel="noopener" class="hero__visual" aria-label="Apri fccds.it, un sito fatto da ProntoDomani">
      <span class="tel tel--sx"><img src="/lavori/fccds-rosa.webp" alt="" width="520" height="795" /></span>
      <span class="tel tel--dx"><img src="/lavori/fccds-calendario.webp" alt="" width="520" height="795" /></span>
      <span class="tel tel--centro"><img src="/lavori/fccds-home.webp" alt="La home di fccds.it vista da smartphone" width="520" height="795" /></span>
      <span class="hero__didascalia"><strong>fccds.it</strong> · fatto da me</span>
    </a>
    {promo.attiva && (
      <a href="/prezzi/#promozione" class="hero__bollino">
        <span>Promozione di lancio</span>
        <strong>START {euro(promo.prezzo)}</strong>
        <span>primi {promo.limite} club</span>
      </a>
    )}
  </section>

  <Promessa24 />

  <Formazione />

  <!-- LAVORI -->
  <section id="lavori" class="fascia-bianca" aria-labelledby="lavori-titolo">
    <div class="contenitore sezione">
      <div class="lavori__testa">
        <h2 id="lavori-titolo" class="titolo-sezione">Già in campo:<br />FC CDS</h2>
        <p class="lead">Terza Categoria, Roma. Il conto alla rovescia per la prossima partita, la diretta su YouTube, la rosa, il calendario con la classifica e una pagina vera per gli sponsor. <a href="https://fccds.it" target="_blank" rel="noopener">Aprilo dal telefono</a>: è lì che lo guardano genitori e tifosi.</p>
      </div>
      <ul class="lavori">
        {schermate.map((s) => (
          <li>
            <span class="tel tel--piatto"><img src={s.img} alt="" width="520" height="795" loading="lazy" /></span>
            <p>{s.cosa}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SPONSOR -->
  <section class="sponsor" aria-labelledby="sponsor-titolo">
    <div class="contenitore sponsor__griglia">
      <div class="sponsor__testo">
        <h2 id="sponsor-titolo">Il sito si ripaga<br />con gli sponsor.</h2>
        <p>Facciamo un esempio. Tre aziende del paese vi danno 200 € a stagione per avere il logo sul sito, con il link al loro. Il pacchetto START è già pagato, e l’anno dopo lo sponsor rinnova mentre il sito resta.</p>
        <p class="piccolo">Le cifre sono un esempio: quanto chiedere agli sponsor lo decidete voi.</p>
      </div>
      <div class="risultato" aria-label={`Esempio: tre sponsor da 200 euro fanno 600 euro, il pacchetto START costa ${promo.prezzo} euro`}>
        <div class="risultato__riga"><span>3 sponsor × 200 €</span><b>600 €</b></div>
        <div class="risultato__riga"><span>Sito START</span><b>−{euro(promo.prezzo)}</b></div>
        <div class="risultato__riga risultato__riga--totale"><span>Risultato</span><b>+{euro(600 - promo.prezzo)}</b></div>
      </div>
    </div>
  </section>

  <!-- NOTA -->
  <section class="contenitore sezione nota-s" aria-labelledby="nota-titolo">
    <h2 id="nota-titolo" class="titolo-medio">Due righe<br />da chi lo fa</h2>
    <div class="nota-s__testo">
      <p>Ciao, sono Samuele.</p>
      <p>Chi manda avanti una società sportiva fa già tre lavori: allenatore, segretario, magazziniere. Il sito finisce sempre in fondo alla lista, e intanto tutto passa da Facebook e dai gruppi WhatsApp dei genitori.</p>
      <p>Io lavoro così: mi mandi stemma, foto e le informazioni che hai, e il giorno dopo hai una bozza vera da aprire sul telefono. Da lì la sistemiamo insieme, con al massimo due giri di modifiche, e il prezzo è quello scritto qui sotto.</p>
      <p>Ogni richiesta la leggo io. Ti rispondo entro un giorno lavorativo.</p>
      <p class="nota-s__firma">Samuele</p>
    </div>
  </section>

  <!-- PREZZI -->
  <section id="prezzi" class="fascia-menta" aria-labelledby="prezzi-titolo">
    <div class="contenitore sezione">
      <div class="intestazione">
        <h2 id="prezzi-titolo" class="titolo-sezione">Quanto costa</h2>
        <p class="lead">Tre pacchetti a prezzo fisso. Colori e stemma della società, versione da telefono, pubblicazione e il primo anno di gestione tecnica sono sempre compresi.</p>
      </div>
      <Pacchetti idTitolo="home" />
      <div class="prezzi__care"><Care compatto /></div>
      <p class="nota prezzi__nota"><a href="/prezzi/" class="link-freccia">Confronto completo e domande sui prezzi</a></p>
    </div>
  </section>

  <CtaFinale
    titolo="Raccontami la tua società."
    testo="Bastano due righe: che sport fate, quante squadre avete, cosa vi manca oggi. Ti rispondo entro un giorno lavorativo con cosa serve per partire."
  />
</Base>

<style>
  /* Hero */
  .hero { position: relative; padding-block: clamp(40px, 6vw, 80px) clamp(56px, 8vw, 96px); display: grid; gap: 48px; align-items: center; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
  .hero__testo { display: flex; flex-direction: column; gap: 22px; }
  .hero__etichetta {
    align-self: flex-start; background: var(--petrolio); color: var(--lime); padding: 6px 12px; border-radius: 4px;
    font-family: var(--font-sport); font-style: italic; font-weight: 800; text-transform: uppercase; font-size: 17px; letter-spacing: .04em;
  }
  h1 { font-size: clamp(54px, 7vw, 96px); color: var(--petrolio); }
  h1 mark {
    display: inline-block; color: var(--petrolio); background: var(--lime); padding: .02em .12em .04em .08em;
    transform: skewX(-6deg); margin-top: .06em;
  }
  .hero .lead { max-width: 33em; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__prove { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 22px; font-weight: 500; font-size: 15px; color: var(--petrolio); }
  .hero__prove li { display: flex; gap: 8px; align-items: center; }

  .tel { display: block; border-radius: 28px; padding: 6px; background: #0c1513; box-shadow: 0 30px 50px -28px rgba(15, 58, 52, .6); }
  .tel img { border-radius: 22px; width: 100%; }

  .hero__visual { position: relative; display: block; height: clamp(420px, 44vw, 560px); text-decoration: none; }
  .hero__visual .tel { position: absolute; width: 44%; }
  .tel--centro { left: 28%; top: 0; z-index: 2; }
  .tel--sx { left: 0; top: 13%; transform: rotate(-6deg); opacity: .96; }
  .tel--dx { right: 0; top: 13%; transform: rotate(6deg); opacity: .96; }
  .hero__didascalia { position: absolute; left: 0; right: 0; bottom: -6px; text-align: center; font-size: 14px; color: var(--grigio-testo); }
  .hero__didascalia strong { color: var(--petrolio); }
  .hero__visual:hover .hero__didascalia strong { text-decoration: underline; }
  .hero__bollino {
    position: absolute; z-index: 3; right: 24px; top: clamp(32px, 5vw, 64px); width: 116px; height: 116px; border-radius: 50%;
    background: var(--lime); color: var(--petrolio); text-decoration: none; border: 3px solid var(--petrolio);
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
    font-size: 10.5px; font-weight: 700; line-height: 1.2; transform: rotate(10deg);
  }
  .hero__bollino strong { font-family: var(--font-sport); font-style: italic; font-size: 21px; font-weight: 800; margin: 2px 0; }
  .hero__bollino:hover { color: var(--petrolio); transform: rotate(4deg) scale(1.04); }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; gap: 28px; }
    .hero__visual { height: auto; aspect-ratio: 1 / .82; max-width: 520px; width: 100%; margin-inline: auto; }
    .hero__bollino { display: none; } /* su smartphone c'è già il pulsante fisso START */
  }

  /* Lavori */
  .lavori__testa { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 20px 56px; align-items: end; margin-bottom: 40px; }
  .lavori { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .lavori li { display: flex; flex-direction: column; gap: 12px; }
  .lavori p { font-size: 14.5px; font-weight: 600; color: var(--petrolio); line-height: 1.35; }
  @media (max-width: 900px) {
    .lavori__testa { grid-template-columns: 1fr; }
    .lavori { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Sponsor */
  .sponsor { background: var(--lime); color: var(--petrolio); }
  .sponsor__griglia { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 40px 64px; align-items: center; padding-block: clamp(56px, 8vw, 96px); }
  .sponsor__testo { display: flex; flex-direction: column; gap: 16px; }
  .sponsor h2 { font-size: clamp(42px, 5.4vw, 70px); }
  .sponsor p { font-size: 18px; max-width: 34em; }
  .sponsor .piccolo { color: var(--petrolio); opacity: .75; font-size: 14px; }
  .risultato { background: var(--petrolio); color: #fff; border-radius: 16px; padding: 10px 24px; box-shadow: 0 24px 40px -26px rgba(15, 58, 52, .8); }
  .risultato__riga { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,.15); }
  .risultato__riga span { font-size: 15px; font-weight: 600; color: #BFD6CF; }
  .risultato__riga b { font-family: var(--font-sport); font-style: italic; font-weight: 800; font-size: 40px; line-height: 1; font-variant-numeric: tabular-nums; }
  .risultato__riga--totale { border-bottom: 0; }
  .risultato__riga--totale span { color: var(--lime); text-transform: uppercase; letter-spacing: .1em; font-size: 13px; }
  .risultato__riga--totale b { color: var(--lime); font-size: 56px; }
  @media (max-width: 860px) { .sponsor__griglia { grid-template-columns: 1fr; } }

  /* Nota di Samuele */
  .nota-s { display: grid; gap: 28px 64px; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); }
  .nota-s__testo { display: flex; flex-direction: column; gap: 16px; max-width: 620px; font-size: 18px; line-height: 1.65; }
  .nota-s__testo p:first-child { font-family: var(--font-titoli); font-weight: 700; color: var(--petrolio); font-size: 21px; }
  .nota-s__firma { font-family: var(--font-sport); font-style: italic; font-weight: 800; color: var(--petrolio); font-size: 30px; text-transform: uppercase; }
  @media (max-width: 860px) { .nota-s { grid-template-columns: 1fr; } }

  .prezzi__care { margin-top: 24px; }
  .prezzi__nota { margin-top: 16px; }
</style>
