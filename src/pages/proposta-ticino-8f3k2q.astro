---
// Pagina RISERVATA per il partner in Ticino. Non è nel menu, né nella sitemap,
// ed è in noindex. Chi ha il link la vede: non metterci dati riservati.
import Base from '../layouts/Base.astro';
import { pacchetti, care, euro } from '../data/site';
// Indirizzo volutamente non indovinabile: contiene i prezzi di cessione.

const aggiornata = '22 novembre 2026';

// Prezzo consigliato al cliente finale, in franchi. PROPOSTA da discutere.
const consigliato: Record<string, string> = { start: '1.290 CHF', plus: '1.790 CHF', premium: '2.490 CHF' };
const minimo: Record<string, string> = { start: '990 CHF', plus: '1.390 CHF', premium: '1.990 CHF' };

const passi = [
  { t: 'Trovi il cliente', d: 'Fai il preventivo e firmi con la tua società, in franchi.' },
  { t: 'Arriva il materiale', d: 'Testi, logo, foto e contatti. Lo raccogli tu e me lo giri, oppure il cliente lo manda direttamente a me.' },
  { t: 'Bozza in 24 ore', d: 'Dal materiale completo, nei giorni lavorativi. Su un indirizzo di prova, da aprire sul telefono.' },
  { t: 'Due giri di modifiche', d: 'Le raccogli tu, oppure parlo io con il cliente: in italiano non c’è nessun problema.' },
  { t: 'Online', d: 'Pubblico sul dominio del cliente con il tuo ok. Tu fatturi al cliente, io fatturo a te.' },
];

const ruoli: [string, string][] = [
  ['Trovare i clienti e vendere', 'Tu'],
  ['Contratto e fattura al cliente, in CHF', 'Tu'],
  ['Primo contatto e raccolta del materiale', 'Tu'],
  ['Design, sviluppo e bozza in 24 ore', 'Io'],
  ['Due giri di modifiche', 'Io'],
  ['Dominio, pubblicazione, hosting, SSL e backup', 'Io'],
  ['Prima risposta al cliente per l’assistenza', 'Tu'],
  ['Assistenza tecnica e problemi del sito', 'Io'],
  ['Testi legali (privacy secondo la nLPD, note legali)', 'Il cliente, con il suo fiduciario. Io li inserisco'],
];
---
<Base riservata title="ProntoDomani in Ticino · Proposta di collaborazione" description="Proposta di collaborazione riservata.">
  <section class="sv-hero erba" aria-labelledby="sv-titolo">
    <div class="contenitore sv-hero__griglia">
      <div>
        <p class="sv-stato">Bozza da discutere · aggiornata il {aggiornata}</p>
        <h1 id="sv-titolo">ProntoDomani in Ticino</h1>
      </div>
      <div class="sv-hero__testo">
        <p>Ciao, qui trovi tutto quello che ci siamo detti, messo in ordine: come lavoriamo, chi fa cosa, i prezzi e le regole.</p>
        <p>I numeri sono una proposta. Li fissiamo insieme e poi li mettiamo in un accordo scritto di una pagina, anche se siamo amici. Anzi, proprio per quello.</p>
        <p class="sv-firma">Samuele</p>
      </div>
    </div>
  </section>

  <section class="contenitore sezione sv-due" aria-labelledby="sv-idea">
    <h2 id="sv-idea" class="titolo-medio">L’idea<br />in breve</h2>
    <div class="sv-testo">
      <p>Tu hai i clienti in Ticino e la fiducia di chi ti conosce. A volte perdi un lavoro perché un sito fatto da un’agenzia svizzera costa troppo per una piccola attività.</p>
      <p>Io faccio siti in fretta e con costi bassi. Tu li vendi con la tua società, al prezzo giusto per il Ticino. Io li realizzo e ti fatturo la mia parte. La differenza resta a te.</p>
      <p>Vale per qualsiasi piccola attività: artigiani, negozi, studi, associazioni. Il mio punto forte sono le società sportive, e <a href="https://fccds.it" target="_blank" rel="noopener">fccds.it</a> è l’esempio da mostrare.</p>
    </div>
  </section>

  <section class="fascia-bianca" aria-labelledby="sv-come">
    <div class="contenitore sezione">
      <h2 id="sv-come" class="titolo-medio sv-titolo">Come funziona</h2>
      <ol class="sv-passi">
        {passi.map((p, i) => (
          <li><span>{i + 1}</span><strong>{p.t}</strong><p>{p.d}</p></li>
        ))}
      </ol>

      <h3 class="sv-sotto">Chi fa cosa</h3>
      <div class="tabella-scorri" tabindex="0" role="region" aria-label="Chi fa cosa">
        <table class="sv-tabella">
          <tbody>
            {ruoli.map(([cosa, chi]) => <tr><th scope="row">{cosa}</th><td class:list={{ io: chi === 'Io', tu: chi === 'Tu' }}>{chi}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="contenitore sezione" aria-labelledby="sv-prezzi">
    <h2 id="sv-prezzi" class="titolo-medio sv-titolo">Prezzi: la mia proposta</h2>
    <div class="tabella-scorri" tabindex="0" role="region" aria-labelledby="sv-prezzi">
      <table class="sv-tabella sv-tabella--prezzi">
        <thead>
          <tr><th scope="col">Pacchetto</th><th scope="col">Pagine</th><th scope="col">Il mio prezzo a te</th><th scope="col">Consigliato al cliente</th><th scope="col">Minimo al cliente</th></tr>
        </thead>
        <tbody>
          {pacchetti.map((p) => (
            <tr>
              <th scope="row">{p.nome}</th>
              <td>{p.pagine.replace('Fino a ', 'fino a ')}</td>
              <td class="io">{euro(p.prezzo)}</td>
              <td class="tu">{consigliato[p.id]}</td>
              <td>{minimo[p.id]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="sv-note">
      <li><strong>Il mio prezzo a te</strong> è il listino italiano, senza la promozione di lancio. Non cambia se tu vendi a di più: la differenza è tua.</li>
      <li><strong>Il prezzo minimo</strong> serve a non svendere il lavoro, e a non far sembrare il Ticino un posto dove si paga come in Italia. Sotto quella cifra ne parliamo prima.</li>
      <li><strong>I prezzi sono per un sito in italiano.</strong> Ogni lingua in più (tedesco, francese, inglese) costa il 50% in più sul mio prezzo. I testi tradotti li fornisce o li approva il cliente.</li>
      <li><strong>Lavori fuori pacchetto</strong> (pagine in più, prenotazioni, negozio online): ti faccio un preventivo prima di iniziare e tu ci metti il tuo margine.</li>
    </ul>
  </section>

  <section class="fascia-menta" aria-labelledby="sv-anni">
    <div class="contenitore sezione sv-due">
      <h2 id="sv-anni" class="titolo-medio">Dal secondo<br />anno</h2>
      <div class="sv-testo">
        <p>Il primo anno di gestione tecnica è compreso nel prezzo. Dal secondo, a te costa <strong>{euro(care.prezzo)} all’anno per sito</strong>: hosting, certificato SSL, backup periodici, monitoraggio e assistenza per problemi tecnici.</p>
        <p>Il rinnovo al cliente lo proponi e lo incassi tu. Prezzo consigliato: <strong>290 CHF all’anno</strong>. Modifiche ai contenuti, nuove pagine e nuove funzioni restano fuori e si preventivano a parte.</p>
      </div>
    </div>
  </section>

  <section class="contenitore sezione sv-due" aria-labelledby="sv-soldi">
    <h2 id="sv-soldi" class="titolo-medio">Pagamenti<br />e fatture</h2>
    <div class="sv-testo">
      <p>Ti fatturo il <strong>50% quando parte il lavoro</strong>, cioè quando arriva il materiale completo, e il <strong>50% alla pubblicazione</strong>. Pagamento a 15 giorni. Il rischio che un cliente paghi in ritardo è tuo, come il guadagno in più.</p>
      <p>Fattura dall’Italia LESGO S.R.L.S., la società dietro ProntoDomani, in euro: è un servizio a un’azienda fuori dall’Unione europea, quindi senza IVA italiana. Dalla tua parte, se sulla mia fattura devi pagare l’IVA svizzera (imposta sull’acquisto) lo verifica il tuo fiduciario. Noi lo verifichiamo con il nostro commercialista.</p>
    </div>
  </section>

  <section class="fascia-bianca" aria-labelledby="sv-nome">
    <div class="contenitore sezione">
      <h2 id="sv-nome" class="titolo-medio sv-titolo">Con che nome vendiamo? Da decidere</h2>
      <div class="sv-scelte">
        <div class="sv-scelta sv-scelta--consigliata">
          <p class="badge">Il mio consiglio</p>
          <h3>A. Con il nome della tua agenzia</h3>
          <p>Il cliente vede solo te. Non trova prontodomani.it con i prezzi italiani e non si chiede perché paga di più. Nel sito del cliente non metto la mia firma, se non la vuoi.</p>
        </div>
        <div class="sv-scelta">
          <h3>B. Come “ProntoDomani”</h3>
          <p>Il marchio e gli esempi sono già pronti. Ma a mezz’ora da Como qualcuno troverà il listino italiano: devi essere pronto a spiegare cosa aggiungi tu (incontro di persona, fattura svizzera, assistenza in Ticino). Si può fare, ma con una risposta pronta.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="contenitore sezione sv-due" aria-labelledby="sv-regole">
    <h2 id="sv-regole" class="titolo-medio">Regole<br />chiare</h2>
    <ul class="sv-regole">
      <li><strong>Siti e domini sono sempre del cliente.</strong> Il dominio .ch è registrato a suo nome.</li>
      <li><strong>Se smettiamo di collaborare</strong>, i siti già online restano online fino alla fine della gestione pagata. Poi il cliente rinnova con chi vuole e io consegno i file.</li>
      <li><strong>Niente login, pagamenti online o dati sensibili</strong> nei siti. Se un cliente li vuole, si collega un servizio esterno fatto apposta.</li>
      <li><strong>Tempi:</strong> 24 ore dal materiale completo, nei giorni lavorativi. Se arrivano più di tre richieste nello stesso giorno, ti dico subito quando consegno.</li>
      <li><strong>Esclusiva (da decidere):</strong> per il Ticino lavoro solo con te per 12 mesi, se nel frattempo vendiamo almeno 6 siti.</li>
    </ul>
  </section>

  <section class="sv-fine erba" aria-labelledby="sv-passi">
    <div class="contenitore sezione">
      <h2 id="sv-passi" class="titolo-medio">Prossimi passi</h2>
      <ol class="sv-prossimi">
        <li>Rileggi e segnami cosa cambieresti.</li>
        <li>Fissiamo i numeri e scegliamo il nome: A o B.</li>
        <li>Mettiamo tutto in un accordo di una pagina.</li>
        <li>Primo cliente di prova: lo seguiamo insieme, dall’inizio alla fine.</li>
      </ol>
    </div>
  </section>
</Base>

<style>
  .sv-hero { color: #DCE9E4; }
  .sv-hero__griglia { display: grid; gap: 32px 64px; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; padding-block: clamp(56px, 8vw, 104px); }
  .sv-hero h1 { color: #fff; font-size: clamp(54px, 7vw, 96px); margin-top: 18px; }
  .sv-stato { display: inline-block; background: var(--lime); color: var(--petrolio); font-weight: 700; font-size: 13px; padding: 5px 10px; border-radius: 4px; }
  .sv-hero__testo { display: flex; flex-direction: column; gap: 14px; font-size: 18px; max-width: 34em; }
  .sv-firma, .sv-hero .sv-firma { font-family: var(--font-sport); font-style: italic; font-weight: 800; text-transform: uppercase; font-size: 28px; color: var(--lime); }

  .sv-due { display: grid; gap: 24px 64px; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); }
  .sv-testo { display: flex; flex-direction: column; gap: 16px; font-size: 18px; line-height: 1.65; max-width: 640px; }
  .sv-titolo { margin-bottom: 32px; }
  .sv-sotto { font-size: 22px; margin: 48px 0 16px; }

  .sv-passi { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .sv-passi li { border-top: 3px solid var(--petrolio); padding-top: 12px; display: flex; flex-direction: column; gap: 6px; }
  .sv-passi span { font-family: var(--font-sport); font-style: italic; font-weight: 800; font-size: 30px; color: var(--verde); line-height: 1; }
  .sv-passi strong { font-family: var(--font-titoli); color: var(--petrolio); font-size: 17px; }
  .sv-passi p { font-size: 15px; line-height: 1.5; }

  .tabella-scorri { overflow-x: auto; }
  .sv-tabella { width: 100%; border-collapse: collapse; font-size: 16px; background: var(--bianco); border: 1px solid var(--bordo); border-radius: 14px; overflow: hidden; }
  .sv-tabella th, .sv-tabella td { text-align: left; padding: 13px 18px; border-bottom: 1px solid var(--bordo); }
  .sv-tabella tbody th { font-weight: 500; color: var(--ardesia); }
  .sv-tabella thead th { font-size: 12.5px; text-transform: uppercase; letter-spacing: .08em; color: var(--grigio-testo); background: var(--carta); }
  .sv-tabella td { font-weight: 600; color: var(--petrolio); white-space: nowrap; }
  .sv-tabella td.io { color: var(--verde); }
  .sv-tabella td.tu { color: var(--petrolio); }
  .sv-tabella--prezzi tbody th { font-family: var(--font-sport); font-style: italic; font-weight: 800; font-size: 22px; color: var(--petrolio); }
  .sv-tabella--prezzi td { font-size: 18px; }
  .sv-tabella tr:last-child th, .sv-tabella tr:last-child td { border-bottom: 0; }

  .sv-note, .sv-regole { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; max-width: 820px; }
  .sv-regole { margin: 0; }
  .sv-note li, .sv-regole li { padding-left: 18px; border-left: 3px solid var(--lime); font-size: 16.5px; }
  .sv-note strong, .sv-regole strong { color: var(--petrolio); }

  .sv-scelte { display: grid; gap: 20px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .sv-scelta { border: 1px solid var(--bordo); border-radius: var(--raggio-grande); padding: 28px; display: flex; flex-direction: column; gap: 12px; background: var(--carta); }
  .sv-scelta--consigliata { border: 2px solid var(--petrolio); }
  .sv-scelta h3 { font-size: 22px; }

  .sv-fine { color: #DCE9E4; }
  .sv-fine h2 { color: #fff; margin-bottom: 24px; }
  .sv-prossimi { margin: 0; padding-left: 1.3em; display: flex; flex-direction: column; gap: 10px; font-size: 19px; }
  .sv-prossimi li::marker { color: var(--lime); font-weight: 800; }

  @media (max-width: 980px) { .sv-passi { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) {
    .sv-hero__griglia, .sv-due, .sv-scelte { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) { .sv-passi { grid-template-columns: 1fr; } }
</style>
