---
import Base from '../layouts/Base.astro';
import Richiesta from '../components/Richiesta.astro';
import { azienda } from '../data/site';

const passi = [
  'Leggiamo la richiesta e ti rispondiamo entro un giorno lavorativo.',
  'Ti mandiamo una proposta chiara e la lista del materiale che serve.',
  'Quando il materiale è completo, entro 24 ore ricevi la prima bozza.',
];
---
<Base title="Contatti · Richiedi il tuo sito · ProntoDomani" description="Richiedi il sito della tua società sportiva: raccontaci chi siete e ti rispondiamo entro un giorno lavorativo con una proposta chiara.">
  <section class="contenitore sezione ct" aria-labelledby="ct-titolo">
    <div class="ct__testo">
      <p class="occhiello">Contatti</p>
      <h1 id="ct-titolo" class="titolo-sezione">Richiedi il tuo sito.</h1>
      <p class="lead">Raccontaci in poche righe la tua società: sport, squadre, cosa vi manca oggi. Nessun impegno: prima ti mandiamo una proposta, poi decidi tu.</p>

      <div class="ct__dopo">
        <p class="ct__etichetta">Cosa succede dopo</p>
        <ol>{passi.map((p) => <li>{p}</li>)}</ol>
      </div>

      <div class="ct__diretti">
        <p class="ct__etichetta">Preferisci scriverci direttamente?</p>
        <ul>
          <li><a href={`mailto:${azienda.email}`}>{azienda.email}</a></li>
          {azienda.telefono && <li><a href={`tel:${azienda.telefono.replace(/\s/g, '')}`}>{azienda.telefono}</a></li>}
          {azienda.whatsapp && <li><a href={`https://wa.me/${azienda.whatsapp}`} rel="noopener">Scrivici su WhatsApp</a></li>}
        </ul>
      </div>
    </div>
    <div class="ct__modulo">
      <Richiesta />
    </div>
  </section>
</Base>

<style>
  .ct { display: grid; gap: 56px; align-items: start; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
  .ct__testo { display: flex; flex-direction: column; gap: 22px; position: sticky; top: 110px; }
  .ct__etichetta { font-weight: 700; color: var(--petrolio); margin-bottom: 10px; }
  .ct__dopo ol { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 8px; }
  .ct__dopo li::marker { color: var(--verde); font-weight: 700; }
  .ct__diretti ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .ct__diretti a { font-weight: 600; display: inline-block; padding: 6px 0; }
  @media (max-width: 900px) { .ct { grid-template-columns: minmax(0, 1fr); } .ct__testo { position: static; } }
</style>
