---
import Base from '../layouts/Base.astro';
---
<Base title="Bozza non più disponibile · ProntoDomani" description="Questa bozza riservata non è più disponibile." noindex>
  <section class="contenitore sezione sezione--stretta" style="display:flex;flex-direction:column;gap:20px;">
    <p class="occhiello">Bozza scaduta</p>
    <h1 class="titolo-sezione">Questa bozza non è più disponibile.</h1>
    <p>Le bozze che prepariamo per i club restano online per 7 giorni. Se vuoi rivederla o parlarne, scrivici: te la rimandiamo volentieri.</p>
    <p style="display:flex;flex-wrap:wrap;gap:12px;">
      <a href="mailto:samuele@prontodomani.it?subject=Bozza%20scaduta" class="btn btn--primario">Scrivi a Samuele</a>
      <a href="/" class="btn btn--secondario">Scopri ProntoDomani</a>
    </p>
  </section>
</Base>
