---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata · ProntoDomani" description="La pagina che cerchi non esiste." noindex>
  <section class="contenitore sezione sezione--stretta" style="display:flex;flex-direction:column;gap:20px;">
    <p class="occhiello">Errore 404</p>
    <h1 class="titolo-sezione">Questa pagina non è ancora online.</h1>
    <p>Forse il link è sbagliato o la pagina è stata spostata.</p>
    <p style="display:flex;flex-wrap:wrap;gap:12px;"><a href="/" class="btn btn--primario">Vai alla home</a><a href="/contatti/" class="btn btn--secondario">Richiedi una proposta</a></p>
  </section>
</Base>
