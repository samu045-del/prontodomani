---
// Siti di ESEMPIO per società inventate (dati in src/data/esempi.ts).
// Pagina autonoma: non usa il layout di ProntoDomani, è in noindex e
// mostra sempre la fascia "sito di esempio".
import '@fontsource/barlow-condensed/700-italic.css';
import '@fontsource/barlow-condensed/800-italic.css';
import '@fontsource/anton/400.css';
import '@fontsource-variable/inter';
import { esempi, type Esempio } from '../../data/esempi';

export function getStaticPaths() {
  return esempi.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props as { e: Esempio };
const t = e.tema;
const fontTitoli = t.font === 'anton' ? "'Anton', Impact, sans-serif" : "'Barlow Condensed', 'Arial Narrow', sans-serif";
const stileTitoli = t.font === 'anton' ? 'normal' : 'italic';
const pesoTitoli = t.font === 'anton' ? 400 : 800;
const voci = [['#club', 'Il club'], ['#squadre', 'Squadre'], ['#partite', 'Partite'], ['#sponsor', 'Sponsor'], ['#iscrizioni', 'Iscrizioni']];
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{e.nomeCompleto} · Sito di esempio ProntoDomani</title>
  <meta name="description" content={`Sito di esempio realizzato da ProntoDomani per una società di ${e.sport.toLowerCase()} inventata.`} />
  <meta name="theme-color" content={t.scuro} />
  <link rel="icon" href="/favicon.svg" />
</head>
<body style={`--fondo:${t.fondo};--scuro:${t.scuro};--acc:${t.accento};--chiaro:${t.chiaro};--testo:${t.testo};--titoli:${fontTitoli};--stile:${stileTitoli};--peso:${pesoTitoli}`} class:list={{ buio: t.buio }}>

  <a class="fascia-esempio" href="https://prontodomani.it/">
    <span><strong>Sito di esempio</strong> · società inventata · realizzato da ProntoDomani</span>
    <span class="fascia-esempio__cta">Vuoi il tuo? →</span>
  </a>

  <header class="testa">
    <div class="box testa__riga">
      <a href="#top" class="marchio">
        <span class="stemma" aria-hidden="true">
          <svg viewBox="0 0 60 70"><path d="M30 2 L57 10 V36 C57 52 45 62 30 68 C15 62 3 52 3 36 V10 Z" fill="var(--scuro)" stroke="var(--acc)" stroke-width="3"/><text x="30" y="43" text-anchor="middle" font-size="22" font-weight="800" fill="#fff" font-family="Inter, sans-serif">{e.sigla}</text></svg>
        </span>
        <span class="marchio__nome">{e.nome}</span>
      </a>
      <nav aria-label="Menu" class="menu">
        {voci.map(([h, l]) => <a href={h}>{l}</a>)}
      </nav>
      <a href="#iscrizioni" class="btn btn--acc btn--piccolo">Prova gratis</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="box hero__griglia">
        <div class="hero__testo">
          <p class="etichetta">{e.sport} · {e.citta} · dal {e.fondata}</p>
          <h1>{e.claim}</h1>
          <p class="hero__sotto">{e.sottotitolo}</p>
          <div class="hero__cta">
            <a href="#iscrizioni" class="btn btn--acc">Iscriviti alla prova</a>
            <a href="#partite" class="btn btn--linea">Calendario</a>
          </div>
        </div>

        <div class="partita" aria-label="Prossima partita">
          <p class="partita__testa"><span class="pallino"></span> Prossima partita in casa</p>
          <p class="partita__camp">{e.prossima.campionato}</p>
          <div class="partita__squadre">
            <div><span class="mini-stemma">{e.sigla}</span><strong>{e.prossima.casa}</strong></div>
            <span class="vs">VS</span>
            <div><span class="mini-stemma mini-stemma--ospite">{e.prossima.ospite.split(' ').map((p) => p[0]).join('').slice(0, 2)}</span><strong>{e.prossima.ospite}</strong></div>
          </div>
          <p class="partita__quando"><span data-prossimo-sabato>Sabato</span> · ore {e.prossima.ora} · {e.prossima.luogo}</p>
          <div class="conto" aria-hidden="true">
            <div><b data-c="g">0</b><small>giorni</small></div>
            <div><b data-c="h">00</b><small>ore</small></div>
            <div><b data-c="m">00</b><small>min</small></div>
            <div class="conto__acc"><b data-c="s">00</b><small>sec</small></div>
          </div>
        </div>
      </div>
    </section>

    <!-- NUMERI -->
    <section class="numeri">
      <div class="box numeri__riga">
        {e.numeri.map((n) => <div><b>{n.n}</b><span>{n.l}</span></div>)}
      </div>
    </section>

    <!-- CLUB + NEWS -->
    <section id="club" class="sezione">
      <div class="box due">
        <div>
          <h2>Il club</h2>
          <p class="grande">{e.nomeCompleto} nasce nel {e.fondata} a {e.citta}. Oggi alleniamo {e.numeri[1].n} {e.numeri[1].l} in {e.numeri[0].n} {e.numeri[0].l}, con una regola sola: in campo si impara, fuori si sta insieme.</p>
          <p>Giochiamo al {e.impianto}, {e.indirizzo}. Le porte sono aperte: genitori, amici e tifosi sono sempre i benvenuti sugli spalti.</p>
        </div>
        <div class="news">
          <h3>Ultime dal club</h3>
          {e.news.map((n) => (
            <article><time>{n.data}</time><div><strong>{n.titolo}</strong><p>{n.testo}</p></div></article>
          ))}
        </div>
      </div>
    </section>

    <!-- SQUADRE -->
    <section id="squadre" class="sezione sezione--chiara">
      <div class="box">
        <h2>Le squadre</h2>
        <ul class="squadre">
          {e.squadre.map((s) => (
            <li>
              <span class="squadre__eta">{s.eta}</span>
              <strong>{s.nome}</strong>
              <span class="squadre__orari">{s.allenamenti}</span>
            </li>
          ))}
        </ul>

        <h3 class="rosa__titolo">La rosa · {e.rosaTitolo}</h3>
        <ul class="rosa">
          {e.rosa.map((g) => (
            <li>
              <span class="rosa__num">{g.numero}</span>
              <span class="rosa__sagoma" aria-hidden="true">
                <svg viewBox="0 0 80 80"><circle cx="40" cy="28" r="15" fill="currentColor" opacity=".35"/><path d="M12 78 C14 56 26 48 40 48 C54 48 66 56 68 78 Z" fill="currentColor" opacity=".35"/></svg>
              </span>
              <strong>{g.nome}</strong>
              <span>{g.ruolo}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PARTITE -->
    <section id="partite" class="sezione">
      <div class="box due">
        <div>
          <h2>Risultati</h2>
          <ul class="risultati">
            {e.risultati.map((r) => (
              <li class:list={{ vinta: r.vinta }}>
                <span class="risultati__camp">{r.campionato}</span>
                <span class="risultati__match">{r.casa} <em>–</em> {r.ospite}</span>
                <b>{r.punteggio}</b>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Classifica</h2>
          <table class="classifica">
            <thead><tr><th>#</th><th>Squadra</th><th>Pt</th></tr></thead>
            <tbody>
              {e.classifica.map((c, i) => <tr class:list={{ noi: c.noi }}><td>{i + 1}</td><td>{c.squadra}</td><td>{c.punti}</td></tr>)}
            </tbody>
          </table>
          <p class="nota">{e.prossima.campionato.split(' · ')[0]}</p>
        </div>
      </div>
    </section>

    <!-- SPONSOR -->
    <section id="sponsor" class="sezione sezione--scura">
      <div class="box">
        <h2>Chi ci sostiene</h2>
        <p class="sponsor__intro">Senza di loro non scenderemmo in campo. Passate a trovarli.</p>
        <ul class="sponsor">
          {e.sponsor.map((s) => <li><span>{s}</span></li>)}
        </ul>
        <a href="#iscrizioni" class="btn btn--acc">Diventa sponsor</a>
      </div>
    </section>

    <!-- ISCRIZIONI -->
    <section id="iscrizioni" class="sezione">
      <div class="box due">
        <div>
          <h2>{e.iscrizioni.titolo}</h2>
          <p class="grande">{e.iscrizioni.testo}</p>
          <ul class="spunte">{e.iscrizioni.punti.map((p) => <li>{p}</li>)}</ul>
        </div>
        <form class="modulo" data-modulo-esempio>
          <label>Nome e cognome<input type="text" name="nome" autocomplete="off" /></label>
          <label>Età dell’atleta<input type="text" name="eta" autocomplete="off" /></label>
          <label>Telefono o email<input type="text" name="contatto" autocomplete="off" /></label>
          <button class="btn btn--acc" type="submit">Prenota la prova</button>
          <p class="modulo__esito" hidden>Questo è un sito di esempio: il modulo non invia nulla. Nel sito vero la richiesta arriva dritta in segreteria.</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="piede">
    <div class="box piede__griglia">
      <div>
        <p class="marchio__nome">{e.nomeCompleto}</p>
        <p>{e.impianto} · {e.indirizzo}</p>
      </div>
      <div class="piede__social" aria-label="Social">
        <span>Instagram</span><span>Facebook</span><span>YouTube</span>
      </div>
      <p class="piede__credito">Società, persone e sponsor sono inventati. Sito di esempio realizzato da <a href="https://prontodomani.it/">ProntoDomani</a>.</p>
    </div>
  </footer>

  <script>
    // Prossimo sabato alle ore della partita: data e conto alla rovescia sempre attuali.
    const elData = document.querySelector('[data-prossimo-sabato]');
    const oraTesto = (document.querySelector('.partita__quando')?.textContent?.match(/ore (\d\d):(\d\d)/)) ?? null;
    const ora = oraTesto ? [Number(oraTesto[1]), Number(oraTesto[2])] : [18, 0];
    const adesso = new Date();
    const partita = new Date(adesso);
    partita.setDate(adesso.getDate() + ((6 - adesso.getDay() + 7) % 7));
    partita.setHours(ora[0], ora[1], 0, 0);
    if (partita <= adesso) partita.setDate(partita.getDate() + 7);
    if (elData) elData.textContent = 'Sabato ' + partita.toLocaleDateString('it-IT', { day: 'numeric', month: 'long' });
    const c = (k: string) => document.querySelector(`[data-c="${k}"]`);
    const due = (n: number) => String(n).padStart(2, '0');
    const aggiorna = () => {
      let r = Math.max(0, Math.floor((partita.getTime() - Date.now()) / 1000));
      c('g')!.textContent = String(Math.floor(r / 86400)); r %= 86400;
      c('h')!.textContent = due(Math.floor(r / 3600)); r %= 3600;
      c('m')!.textContent = due(Math.floor(r / 60));
      c('s')!.textContent = due(r % 60);
    };
    aggiorna(); setInterval(aggiorna, 1000);

    // Il modulo di esempio non invia nulla: lo dice e basta.
    document.querySelector('[data-modulo-esempio]')?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      (document.querySelector('.modulo__esito') as HTMLElement).hidden = false;
    });
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; }
  body { margin: 0; background: var(--fondo); color: var(--testo); font: 16px/1.6 'Inter Variable', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  h1, h2, h3, p, ul { margin: 0; }
  ul { padding: 0; list-style: none; }
  a { color: inherit; }
  h1, h2 { font-family: var(--titoli); font-style: var(--stile); font-weight: var(--peso); text-transform: uppercase; line-height: .95; letter-spacing: .005em; color: var(--scuro); }
  body.buio h1, body.buio h2 { color: #fff; }
  h2 { font-size: clamp(38px, 5vw, 60px); margin-bottom: 20px; }
  h3 { font-size: 18px; font-weight: 700; }
  .box { width: min(100% - 40px, 1160px); margin-inline: auto; }
  .sezione { padding-block: clamp(56px, 8vw, 96px); }
  .sezione--chiara { background: var(--chiaro); }
  .sezione--scura { background: var(--scuro); color: #fff; }
  .sezione--scura h2 { color: #fff; }
  .due { display: grid; gap: 40px 64px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); align-items: start; }
  .grande { font-size: 19px; margin-bottom: 14px; }
  .nota { font-size: 13px; opacity: .7; margin-top: 10px; }

  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; border-radius: 999px; font-weight: 700; text-decoration: none; border: 2px solid transparent; cursor: pointer; font-size: 15.5px; font-family: inherit; }
  .btn--acc { background: var(--acc); color: #111; }
  .btn--linea { border-color: currentColor; color: inherit; }
  .btn--piccolo { min-height: 40px; padding: 0 16px; font-size: 14px; }

  .fascia-esempio { display: flex; justify-content: center; flex-wrap: wrap; gap: 4px 14px; padding: 8px 16px; background: #C6F36B; color: #0F3A34; font-size: 13px; text-decoration: none; text-align: center; }
  .fascia-esempio__cta { font-weight: 700; text-decoration: underline; }

  .testa { position: sticky; top: 0; z-index: 10; background: var(--scuro); color: #fff; }
  .testa__riga { display: flex; align-items: center; gap: 24px; min-height: 68px; }
  .marchio { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .stemma svg { width: 38px; height: 44px; display: block; }
  .marchio__nome { font-family: var(--titoli); font-style: var(--stile); font-weight: var(--peso); text-transform: uppercase; font-size: 24px; letter-spacing: .02em; }
  .menu { display: flex; gap: 22px; margin-left: auto; font-weight: 600; font-size: 15px; }
  .menu a { text-decoration: none; opacity: .9; }
  .menu a:hover { color: var(--acc); }
  @media (max-width: 860px) { .menu { display: none; } .testa .btn { margin-left: auto; } }

  .hero { background: var(--scuro); color: #fff; position: relative; overflow: hidden; }
  .hero::before { content: ''; position: absolute; inset: 0; opacity: .12; pointer-events: none;
    background: repeating-linear-gradient(-55deg, transparent 0 46px, var(--acc) 46px 50px); }
  .hero__griglia { position: relative; display: grid; gap: 40px; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; padding-block: clamp(48px, 7vw, 96px); }
  .hero__testo { display: flex; flex-direction: column; gap: 20px; }
  .etichetta { align-self: flex-start; background: var(--acc); color: #111; font-weight: 700; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; padding: 5px 10px; border-radius: 4px; }
  .hero h1 { color: #fff; font-size: clamp(60px, 9vw, 120px); }
  .hero__sotto { font-size: 19px; max-width: 30em; opacity: .9; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 900px) { .hero__griglia { grid-template-columns: 1fr; } }

  .partita { background: #fff; color: #1b1b1b; border-radius: 18px; padding: 22px; box-shadow: 0 30px 60px -30px rgba(0,0,0,.6); }
  body.buio .partita { background: #201a1b; color: #fff; border: 1px solid #3a3032; }
  .partita__testa { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #c0392b; }
  body.buio .partita__testa { color: var(--acc); }
  .pallino { width: 8px; height: 8px; border-radius: 50%; background: currentColor; animation: pulsa 1.6s infinite; }
  @keyframes pulsa { 50% { opacity: .3; } }
  .partita__camp { font-size: 13px; opacity: .7; margin-top: 6px; }
  .partita__squadre { display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: center; text-align: center; margin: 18px 0 12px; }
  .partita__squadre div { display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 14px; line-height: 1.25; }
  .mini-stemma { width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; background: var(--scuro); color: #fff; font-weight: 800; border: 3px solid var(--acc); }
  .mini-stemma--ospite { background: #6b7280; border-color: #d1d5db; }
  .vs { font-family: var(--titoli); font-style: var(--stile); font-weight: var(--peso); font-size: 26px; color: var(--acc); }
  .partita__quando { text-align: center; font-size: 14px; font-weight: 600; }
  .conto { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 16px; }
  .conto div { background: var(--chiaro); border-radius: 8px; text-align: center; padding: 8px 4px; }
  body.buio .conto div { background: #2c2426; }
  .conto b { display: block; font-family: var(--titoli); font-style: var(--stile); font-weight: var(--peso); font-size: 32px; line-height: 1; color: var(--scuro); font-variant-numeric: tabular-nums; }
  body.buio .conto b { color: #fff; }
  .conto small { font-size: 10px; text-transform: uppercase; letter-spacing: .1em; opacity: .7; }
  .conto div.conto__acc, body.buio .conto div.conto__acc { background: var(--acc); }
  .conto .conto__acc b, .conto .conto__acc small, body.buio .conto .conto__acc b { color: #111; }

  .numeri { background: var(--acc); color: #111; }
  .numeri__riga { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; padding-block: 22px; text-align: center; }
  .numeri b { display: block; font-family: var(--titoli); font-style: var(--stile); font-weight: var(--peso); font-size: clamp(36px, 5vw, 56px); line-height: 1; }
  .numeri span { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }

  .news { display: flex; flex-direction: column; gap: 14px; }
  .news article { display: flex; gap: 16px; padding: 16px; border-radius: 14px; background: var(--chiaro); }
  .news time { flex: none; width: 52px; text-align: center; font-weight: 800; font-size: 13px; text-transform: uppercase; color: var(--scuro); background: var(--acc); border-radius: 8px; padding: 6px 4px; height: fit-content; }
  body.buio .news time { color: #111; }
  .news strong { display: block; }
  .news p { font-size: 14.5px; opacity: .85; }

  .squadre { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); }
  .squadre li { background: var(--fondo); border-radius: 14px; padding: 18px 20px; display: flex; flex-direction: column; gap: 4px; border-left: 5px solid var(--acc); }
  .squadre strong { font-size: 18px; }
  .squadre__eta { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; opacity: .65; }
  .squadre__orari { font-size: 14px; }

  .rosa__titolo { margin: 48px 0 18px; font-size: 20px; }
  .rosa { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .rosa li { position: relative; background: var(--scuro); color: #fff; border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 2px; overflow: hidden; }
  .rosa__num { position: absolute; top: 6px; right: 10px; font-family: var(--titoli); font-style: var(--stile); font-weight: var(--peso); font-size: 38px; line-height: 1; color: var(--acc); }
  .rosa__sagoma { color: #fff; }
  .rosa__sagoma svg { width: 72px; height: 72px; display: block; margin-bottom: 6px; }
  .rosa strong { font-size: 17px; }
  .rosa span:last-child { font-size: 13px; opacity: .8; }

  .risultati { display: flex; flex-direction: column; gap: 10px; }
  .risultati li { display: grid; grid-template-columns: 82px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 14px 16px; border-radius: 12px; background: var(--chiaro); border-left: 5px solid #9ca3af; }
  .risultati li.vinta { border-left-color: #16a34a; }
  .risultati__camp { font-size: 12px; font-weight: 700; text-transform: uppercase; opacity: .7; }
  .risultati__match { font-size: 15px; font-weight: 600; }
  .risultati em { font-style: normal; opacity: .5; }
  .risultati b { font-family: var(--titoli); font-style: var(--stile); font-weight: var(--peso); font-size: 26px; }
  @media (max-width: 480px) { .risultati li { grid-template-columns: 1fr auto; } .risultati__camp { grid-column: 1 / -1; } }

  .classifica { width: 100%; border-collapse: collapse; background: var(--chiaro); border-radius: 12px; overflow: hidden; font-size: 15px; }
  .classifica th, .classifica td { padding: 11px 14px; text-align: left; }
  .classifica th { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; opacity: .7; }
  .classifica td:last-child, .classifica th:last-child { text-align: right; font-weight: 800; }
  .classifica tr.noi { background: var(--acc); color: #111; font-weight: 700; }

  .sponsor__intro { margin-bottom: 26px; opacity: .85; font-size: 18px; }
  .sponsor { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); margin-bottom: 28px; }
  .sponsor li { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.18); border-radius: 12px; min-height: 86px; display: grid; place-items: center; text-align: center; padding: 12px; }
  .sponsor span { font-family: var(--titoli); font-style: var(--stile); font-weight: var(--peso); text-transform: uppercase; font-size: 21px; line-height: 1.05; }

  .spunte { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
  .spunte li { padding-left: 26px; position: relative; font-weight: 600; }
  .spunte li::before { content: '✓'; position: absolute; left: 0; color: var(--acc); font-weight: 900; }
